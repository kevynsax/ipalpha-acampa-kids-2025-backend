# ── Server ────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ── MongoDB ───────────────────────────────────────────────
MONGODB_URI=mongodb://camping:camping-local-only@localhost:27019/camping?authSource=admin
MONGODB_DB=camping

# ── Auth / session ────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
SESSION_HOURS=24

# ── OTP (one-time passcode) ───────────────────────────────
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
ACCOUNT_FREEZE_MINUTES=30
RESEND_COOLDOWN_SECONDS=60

# ── Comtele (Brazilian SMS provider) ──────────────────────
COMTELE_API_KEY=
COMTELE_PREFIX=AcampaKids

# ── Notifications (SMS to the team when their room / escala changes) ──
# Public URL of the app, appended to the SMS so the person can tap it.
APP_URL=
# Changes to the same person within this window become ONE SMS (default 20s).
NOTIFY_COALESCE_SECONDS=20

# ── AI helper in the WYSIWYG editor (OpenAI-compatible gateway) ──
# Leave EMPTY to hide the feature.
AI_BASE_URL=https://ai-models.kevyn.com.br/v1
AI_API_KEY=
# Speech-to-text for voice messages in the assistant chat (OpenAI-compatible /audio/transcriptions).
# Defaults to the home whisper server; set AI_TRANSCRIBE_URL empty to hide the mic.
# AI_TRANSCRIBE_URL=https://whisper.kevyn.com.br/v1
# AI_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# AI_TRANSCRIBE_KEY=
